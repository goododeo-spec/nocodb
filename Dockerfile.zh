# Build a custom NocoDB image with a rebuilt (localized) nc-gui frontend.
# Stage 1: build nc-gui static output from source (includes our i18n changes).
FROM node:24-bookworm AS gui

WORKDIR /repo

# Use pnpm 10 (workspace uses pnpm 10+ features: blockExoticSubdeps, minimumReleaseAge)
RUN npm install -g pnpm@10.16.1

COPY . .

# Install only nc-gui and its workspace dependencies (nocodb-sdk, nocodb-sdk-v2),
# build the SDKs, then generate the static frontend.
RUN pnpm install --filter "nc-gui..." \
 && pnpm --filter nocodb-sdk run build \
 && pnpm --filter nocodb-sdk-v2 run build

RUN cd packages/nc-gui \
 && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=6144 npx nuxi generate

# Stage 2: overlay the freshly built frontend onto the official image.
# Pin by digest to the exact backend running in prod (release 2026.06.1) so the
# frontend/backend internal-operation contract stays in lockstep (no latest drift).
FROM nocodb/nocodb@sha256:e5a6ac9cfa59f78b333b491efde4b6cd60bb866b49c76daf92295ef359ef710e

RUN rm -rf /usr/src/app/docker/nc-gui
COPY --from=gui /repo/packages/nc-gui/.output/public /usr/src/app/docker/nc-gui
